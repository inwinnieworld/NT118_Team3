<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmotionDebugging"
        android:usesCleartextTraffic="true">

        <!-- ========== LAUNCHER (START SCREEN) ========== -->
        <activity
            android:name=".ui.splash.StartScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========== AUTHENTICATION FLOW (Code của Thắng) ========== -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.ResetPasswordActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="reset-password"
                    android:scheme="emotedebugging" />
            </intent-filter>
        </activity>

        <!-- ========== MAIN SCREENS ========== -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.StudentQuestCatalogActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.StaffDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.QuestBuilderActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ui.staff.QuestSceneDesignerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.staff.QuestPreviewActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminQuestReviewActivity"
            android:exported="false" />

        <!-- ========== PROFILE SCREENS (Code của Chính) ========== -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.ChangePasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.community.CommunityActivity"
            android:exported="false" />
        <activity
            android:name=".ui.community.CreatePostActivity"
            android:exported="false" />
        <activity
            android:name=".ui.community.PostDetailActivity"
            android:exported="false" />

        <!-- ========== ADMIN SCREENS (Code của Chính) ========== -->
        <activity
            android:name=".ui.admin.ManageStudentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.EditStudentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.EditStaffActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AddStaffActivity"
            android:exported="false" />

        <!-- ========== GIT JOURNAL SCREENS (Code của Thắng) ========== -->
        <activity
            android:name=".ui.journal.GitJournalActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.gitgraph.GitGraphActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ========== STAFF QUEST MANAGEMENT (Code của AnAn) ========== -->
        <activity
            android:name=".ui.staff.ManageQuestActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.EditQuestActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.QuestReportActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.ManageTraceQuestionActivity"
            android:exported="false"/>
        <activity
            android:name=".ui.staff.CreateTraceQuestionActivity"
            android:exported="false"/>
        <activity
            android:name=".ui.staff.TraceQuestionDetailActivity"
            android:exported="false"/>
    </application>

</manifest>
