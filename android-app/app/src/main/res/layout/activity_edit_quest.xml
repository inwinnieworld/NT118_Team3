<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#EAEAEA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:background="@drawable/bg_quest_header">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="18dp"
                android:layout_marginTop="26dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#95EAFF" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="28dp"
                android:text="QUẢN LÝ QUEST"
                android:textAllCaps="true"
                android:textColor="#82E8FF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- CONTENT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-18dp"
            android:background="@drawable/bg_quest_container"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="24dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tvInfoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="THÔNG TIN QUEST"
                android:textColor="#1197B6"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- TÊN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="TÊN"
                    android:textColor="#2C4A5A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtQuestName"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quest_input"
                    android:gravity="center"
                    android:hint="Điền tên quest"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#2C4A5A"
                    android:textColorHint="#19B7DB"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- MÔ TẢ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="MÔ TẢ"
                    android:textColor="#2C4A5A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtQuestDescription"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quest_input"
                    android:gravity="center"
                    android:hint="Điền mô tả quest"
                    android:inputType="textMultiLine"
                    android:padding="18dp"
                    android:textColor="#2C4A5A"
                    android:textColorHint="#19B7DB"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- LEVEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="LEVEL_SEVERITY"
                android:textColor="#2C4A5A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/cbLevel1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Level 1"
                        android:textColor="#445D6C"
                        android:textSize="16sp" />

                    <CheckBox
                        android:id="@+id/cbLevel2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Level 2"
                        android:textColor="#445D6C"
                        android:textSize="16sp" />

                    <CheckBox
                        android:id="@+id/cbLevel3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Level 3"
                        android:textColor="#445D6C"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/cbLevel4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Level 4"
                        android:textColor="#445D6C"
                        android:textSize="16sp" />

                    <CheckBox
                        android:id="@+id/cbLevel5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Level 5"
                        android:textColor="#445D6C"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- BASE PRIORITY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:text="BASE PRIORITY"
                    android:textColor="#2C4A5A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtBasePriority"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quest_input"
                    android:gravity="center"
                    android:hint="Điền số (1-100)"
                    android:inputType="number"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#2C4A5A"
                    android:textColorHint="#19B7DB"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- TAG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="TAG"
                    android:textColor="#2C4A5A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtTag"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quest_input"
                    android:gravity="center"
                    android:hint="Tìm kiếm tag của phương án để điền..."
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#2C4A5A"
                    android:textColorHint="#19B7DB"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- ESTIMATED DUR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:text="ESTIMATED DUR."
                    android:textColor="#2C4A5A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtEstimatedDuration"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quest_input"
                    android:gravity="center"
                    android:hint="Điền số phút"
                    android:inputType="number"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#2C4A5A"
                    android:textColorHint="#19B7DB"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- ACTION -->
            <TextView
                android:id="@+id/tvBackText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Quay lại"
                android:textColor="#75818A"
                android:textSize="14sp"
                android:textStyle="italic" />

            <Button
                android:id="@+id/btnUpdateQuest"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="-10dp"
                android:background="@drawable/bg_save_button"
                android:text="LƯU"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>