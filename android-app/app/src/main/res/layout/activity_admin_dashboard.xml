<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_student_homescreen">

    <LinearLayout
        android:id="@+id/layoutTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_menu_glass"
        android:paddingStart="24dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emotion Debugging"
            android:textColor="#85E9FF"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutTopMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTitle"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_userinfo" />
        <ImageView
            android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_notification" />
        <ImageView
            android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_setting" />
        <ImageView
            android:id="@+id/ivAdminLogout"
            android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_logout"
            android:contentDescription="Log out"
            android:tooltipText="Log out"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardAdminMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_admin_menu_card"
        android:padding="24dp"
        android:layout_marginHorizontal="32dp"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTopMenu"
        app:layout_constraintBottom_toTopOf="@id/layoutAdminStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHỌN CÔNG VIỆC MUỐN LÀM"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnManageAccount"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_admin_button"
            android:text="Quản lý tài khoản" android:textAllCaps="false"
            android:textColor="#000000" android:textStyle="bold"
            android:layout_marginBottom="12dp" android:elevation="4dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSystemReport"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_admin_button"
            android:text="Báo cáo hệ thống" android:textAllCaps="false"
            android:textColor="#000000" android:textStyle="bold"
            android:layout_marginBottom="12dp" android:elevation="4dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnManageCommunity"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_admin_button"
            android:text="Community management" android:textAllCaps="false"
            android:textColor="#000000" android:textStyle="bold"
            android:layout_marginBottom="12dp" android:elevation="4dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReviewQuest"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_admin_button"
            android:text="Quest review" android:textAllCaps="false"
            android:textColor="#000000" android:textStyle="bold"
            android:layout_marginBottom="12dp" android:elevation="4dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnManageErrorCode"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_admin_button"
            android:text="Quản lý mã lỗi cảm xúc" android:textAllCaps="false"
            android:textColor="#000000" android:textStyle="bold"
            android:layout_marginBottom="12dp" android:elevation="4dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnManageEmergency"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_admin_button"
            android:text="Quản lý dữ liệu khẩn cấp" android:textAllCaps="false"
            android:textColor="#000000" android:textStyle="bold"
            android:layout_marginBottom="12dp" android:elevation="4dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnManageDictionary"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_admin_button"
            android:text="Quản lý bộ từ điển cảm xúc" android:textAllCaps="false"
            android:textColor="#000000" android:textStyle="bold"
            android:elevation="4dp"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivAdminMascot"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_mascot"
        android:elevation="12dp"
        android:layout_marginEnd="-20dp"
        android:layout_marginBottom="-30dp"
        app:layout_constraintEnd_toEndOf="@id/cardAdminMenu"
        app:layout_constraintBottom_toBottomOf="@id/cardAdminMenu" />

    <LinearLayout
        android:id="@+id/layoutAdminStatus"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_admin_status"
        android:gravity="center"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvAdminStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
