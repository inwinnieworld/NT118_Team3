<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#111111"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Messages"
            android:textColor="#111111"
            android:textSize="30sp"
            android:textStyle="bold"
            android:paddingStart="14dp" />

        <TextView
            android:id="@+id/btn_new_message"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✎"
            android:textColor="#111111"
            android:textSize="28sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="@drawable/bg_message_search">

        <TextView
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#9CA3AF"
            android:textSize="30sp" />

        <EditText
            android:id="@+id/et_search_message"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Search"
            android:textColor="#111111"
            android:textColorHint="#9CA3AF"
            android:textSize="20sp"
            android:singleLine="true"
            android:paddingStart="10dp"
            android:inputType="text" />

    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/tab_inbox"
            android:layout_width="112dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="Inbox"
            android:textColor="#111111"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/bg_message_tab_selected" />

        <TextView
            android:id="@+id/tab_requests"
            android:layout_width="124dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:text="Requests"
            android:textColor="#111111"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/bg_message_tab_unselected" />

    </LinearLayout>

    <!-- Empty text -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chưa có cuộc trò chuyện nào"
        android:textColor="#9CA3AF"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_conversations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="6dp"
        android:paddingBottom="24dp"
        tools:listitem="@layout/item_conversation" />

</LinearLayout>