<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_my_profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_profile_machine"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Top bar: back + block icon -->
        <LinearLayout
            android:id="@+id/layout_profile_header"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="◀"
                android:textColor="#12B2C1"
                android:textSize="26sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- kept for Java compatibility, hidden -->
            <TextView
                android:id="@+id/tv_header_username"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_more"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="⊘"
                android:textColor="#12B2C1"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile info card -->
        <LinearLayout
            android:id="@+id/layout_profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="70dp">

                    <TextView
                        android:id="@+id/tv_display_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trương Nguyên Đại Thắng"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- kept for Java compatibility, hidden -->
                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- kept for Java compatibility, hidden -->
                    <TextView
                        android:id="@+id/tv_student_info"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_bio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tiểu sử của bạn"
                        android:textColor="#9CA3AF"
                        android:textSize="14sp"
                        android:textStyle="italic" />

                    <!-- Your music -->
                    <LinearLayout
                        android:id="@+id/layout_music"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_play_music"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_teal_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="▶"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_music_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Your music"
                            android:textColor="#6B7280"
                            android:textSize="14sp"
                            android:textStyle="italic" />

                        <LinearLayout
                            android:id="@+id/layout_equalizer"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginStart="10dp"
                            android:gravity="bottom"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <View
                                android:id="@+id/eq_bar_1"
                                android:layout_width="4dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="3dp"
                                android:background="#12B2C1" />

                            <View
                                android:id="@+id/eq_bar_2"
                                android:layout_width="4dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="3dp"
                                android:background="#12B2C1" />

                            <View
                                android:id="@+id/eq_bar_3"
                                android:layout_width="4dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="3dp"
                                android:background="#12B2C1" />

                            <View
                                android:id="@+id/eq_bar_4"
                                android:layout_width="4dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="3dp"
                                android:background="#12B2C1" />

                            <View
                                android:id="@+id/eq_bar_5"
                                android:layout_width="4dp"
                                android:layout_height="10dp"
                                android:background="#12B2C1" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- follow stats -->
                    <LinearLayout
                        android:id="@+id/layout_follow_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_followers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="0 follower"
                            android:textColor="#6B7280"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_following"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="28dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="0 following"
                            android:textColor="#6B7280"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_avatar_circle"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <!-- Edit + Messages buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_teal_button"
                    app:backgroundTint="@null"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_message"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="2.4"
                    android:background="@drawable/bg_teal_button"
                    app:backgroundTint="@null"
                    android:text="Messages"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- kept for Java compatibility, hidden -->
                <Button
                    android:id="@+id/btn_follow"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tabs card -->
        <LinearLayout
            android:id="@+id/layout_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_profile_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tab_posts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_tab_selected"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Your Log"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_reposts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Repost"
                android:textColor="#9CA3AF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_saved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Saved"
                android:textColor="#9CA3AF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- kept for Java compatibility, hidden -->
            <TextView
                android:id="@+id/tab_replies"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tab_media"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Content card: composer + finish + posts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical">

            <!-- Composer -->
            <LinearLayout
                android:id="@+id/layout_composer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/iv_my_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tv_whats_new"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="What's new?"
                    android:textColor="#9CA3AF"
                    android:textSize="16sp"
                    android:textStyle="italic" />

                <Button
                    android:id="@+id/btn_composer_post"
                    android:layout_width="84dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_teal_button"
                    app:backgroundTint="@null"
                    android:text="Post"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/divider_composer"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB" />

            <!-- Finish your profile -->
            <LinearLayout
                android:id="@+id/layout_finish_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Finish your profile"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_finish_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 left"
                        android:textColor="#6B7280"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_finish_cards"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <!-- Card 1: Create your first log -->
                    <FrameLayout
                        android:id="@+id/card_create_thread"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_teal_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="Create your first log"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_finish_create_check"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_white_circle"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="#179FB5"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Card 2: Follow 10 profiles -->
                    <FrameLayout
                        android:id="@+id/card_follow_profiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_teal_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="Follow 10 profiles"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_finish_follow_check"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_white_circle"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="#179FB5"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Card 3: Edit your profile -->
                    <FrameLayout
                        android:id="@+id/card_add_bio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_teal_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="Edit your profile"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_finish_bio_check"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_white_circle"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="#179FB5"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_posts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:gravity="center"
                android:text="Chưa có bài viết nào"
                android:textColor="#9CA3AF"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
