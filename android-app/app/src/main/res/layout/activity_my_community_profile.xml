<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_my_profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/layout_profile_header"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="←"
                android:textColor="#000000"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/tv_header_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:text="aioshimaaaa"
                android:textColor="#000000"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#000000"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_more"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="⊙"
                android:textColor="#000000"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile card -->
        <LinearLayout
            android:id="@+id/layout_profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="26dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical">

            <!-- Profile info -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:paddingStart="28dp"
                android:paddingTop="28dp"
                android:paddingEnd="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_display_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thúy An"
                        android:textColor="#000000"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="aioshimaaaa"
                        android:textColor="#111111"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/tv_bio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text=""
                        android:textColor="#111111"
                        android:textSize="16sp" />

                    <!-- followers row -->
                    <LinearLayout
                        android:id="@+id/layout_follow_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:gravity="center"
                            android:text="A"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="-7dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:gravity="center"
                            android:text="B"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="-7dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:gravity="center"
                            android:text="C"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_followers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="0 followers"
                            android:textColor="#9CA3AF"
                            android:textSize="19sp" />

                        <!-- Giữ ID này cho Java, nhưng ẩn để UI giống ảnh -->
                        <TextView
                            android:id="@+id/tv_following"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 following"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_avatar_circle"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/btn_chart"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginBottom="38dp"
                    android:gravity="center"
                    android:text="▥"
                    android:textColor="#000000"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Edit profile -->
            <Button
                android:id="@+id/btn_edit_profile"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_profile_outline_button"
                android:text="Edit profile"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Hidden IDs for Java compatibility -->
            <Button
                android:id="@+id/btn_follow"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_message"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Tabs -->
            <LinearLayout
                android:id="@+id/layout_tabs"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_posts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Posts"
                    android:textColor="#000000"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_replies"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Replies"
                    android:textColor="#9CA3AF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_media"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Media"
                    android:textColor="#9CA3AF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_reposts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Reposts"
                    android:textColor="#9CA3AF"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB" />

            <!-- Composer -->
            <LinearLayout
                android:id="@+id/layout_composer"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <ImageView
                    android:id="@+id/iv_my_avatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tv_whats_new"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="What's new?"
                    android:textColor="#9CA3AF"
                    android:textSize="21sp" />

                <Button
                    android:id="@+id/btn_composer_post"
                    android:layout_width="88dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_profile_outline_button"
                    android:text="Post"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB" />

            <!-- Finish your profile -->
            <LinearLayout
                android:id="@+id/layout_finish_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="24dp"
                android:paddingEnd="28dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Finish your profile"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 left"
                        android:textColor="#000000"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <!-- Card 1 -->
                    <LinearLayout
                        android:id="@+id/card_create_thread"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_finish_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:background="@drawable/bg_white_circle"
                            android:gravity="center"
                            android:text="↗"
                            android:textColor="#000000"
                            android:textSize="34sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Create post"
                            android:textColor="#000000"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Say what’s on your mind or share a recent highlight."
                            android:textColor="#9CA3AF"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/btn_finish_create"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_black_button"
                            android:text="Create"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Card 2 -->
                    <LinearLayout
                        android:id="@+id/card_follow_profiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_finish_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:background="@drawable/bg_white_circle"
                            android:gravity="center"
                            android:text="♙"
                            android:textColor="#000000"
                            android:textSize="34sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Follow 10 profiles"
                            android:textColor="#000000"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Fill your feed with Emotion Debbuging that interest you."
                            android:textColor="#9CA3AF"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/btn_finish_follow"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_black_button"
                            android:text="See profiles"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Card 3 -->
                    <LinearLayout
                        android:id="@+id/card_add_bio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_finish_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:background="@drawable/bg_white_circle"
                            android:gravity="center"
                            android:text="✎"
                            android:textColor="#000000"
                            android:textSize="34sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Add bio"
                            android:textColor="#000000"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Introduce yourself and tell people what you’re into."
                            android:textColor="#9CA3AF"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/btn_finish_add_bio"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_black_button"
                            android:text="Add"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_posts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:gravity="center"
                android:text="Chưa có bài viết nào"
                android:textColor="#9CA3AF"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>