<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E5E7EB"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/layoutEnginePanel"
        android:layout_width="112dp"
        android:layout_height="match_parent"
        android:background="#F8FAFC"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ENGINE"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenDraft"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#475569"
            android:minWidth="0dp"
            android:text="Open"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnAiMetadata"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#475569"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp"
            android:text="Category"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="9sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutEngineButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etQuestTitle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_field_card"
                android:hint="Quest title"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etQuestDescription"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.7"
                android:background="@drawable/bg_field_card"
                android:hint="Description"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etQuestLevel"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_field_card"
                android:hint="Lv"
                android:inputType="number"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnConnectMode"
                android:layout_width="92dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#334155"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="-> link"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnPreviewQuest"
                android:layout_width="92dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#7C3AED"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="Preview"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnSaveDraft"
                android:layout_width="88dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/primary_dark"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnSubmitReview"
                android:layout_width="96dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#0F766E"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="Submit"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="#CBD5E1"
            android:padding="16dp">

            <com.example.emotiondebugging.ui.staff.QuestCanvasView
                android:id="@+id/questCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/layoutConfigPanel"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

        <TextView
            android:id="@+id/tvConfigTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Config"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNodeName"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_field_card"
            android:hint="Display name"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPrimaryConfig"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:hint="Text / file / action"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPickPrimaryAsset"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#4F46E5"
            android:text="Pick image"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerGestureType"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:paddingHorizontal="10dp"
            android:prompt="@string/select_gesture_type"
            android:spinnerMode="dialog"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etSecondaryConfig"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:hint="Seconds / count / size / volume"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etBackgroundSoundUrl"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:hint="Background music file"
            android:inputType="textUri"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPickBackgroundSound"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#7C3AED"
            android:text="Pick background music"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etBackgroundSoundVolume"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:hint="Music volume 0-100"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerMediaPosition"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:paddingHorizontal="10dp"
            android:prompt="@string/select_media_position"
            android:spinnerMode="dialog"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutImageSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/etImageWidth"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field_card"
                android:hint="Width"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etImageHeight"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field_card"
                android:hint="Height"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:singleLine="true" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerSensorAction"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:paddingHorizontal="10dp"
            android:prompt="@string/select_sensor_action"
            android:spinnerMode="dialog"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerVoiceMode"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:paddingHorizontal="10dp"
            android:prompt="@string/select_voice_mode"
            android:spinnerMode="dialog"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerParallelCondition"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:paddingHorizontal="10dp"
            android:prompt="@string/select_parallel_condition"
            android:spinnerMode="dialog"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTransitionTypeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Transition trigger"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerTransitionType"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field_card"
            android:paddingHorizontal="10dp"
            android:spinnerMode="dialog"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTransitionEffectLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Visual transition"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerTransitionEffect"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field_card"
            android:paddingHorizontal="10dp"
            android:spinnerMode="dialog"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAttachedEngineTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Attached engine"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerAttachedEngine"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:paddingHorizontal="10dp"
            android:prompt="@string/select_attached_engine"
            android:spinnerMode="dialog"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etAttachedPrimaryConfig"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:hint="Attached primary config"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerAttachedGestureType"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:paddingHorizontal="10dp"
            android:prompt="@string/select_attached_gesture"
            android:spinnerMode="dialog"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerAttachedSwipeDirection"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:paddingHorizontal="10dp"
            android:prompt="@string/select_swipe_direction"
            android:spinnerMode="dialog"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etAttachedSecondaryConfig"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field_card"
            android:hint="Attached secondary config"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDesignPosition"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#334155"
            android:text="Design position"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnOpenFrame"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#334155"
            android:text="Open frame"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnApplyConfig"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/primary"
            android:text="Apply"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnRemoveNode"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/logout_text"
            android:text="Delete engine"
            android:textAllCaps="false"
            android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
