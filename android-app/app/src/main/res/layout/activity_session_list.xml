<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_screen">

    <!-- ========== HEADER (tái dùng cấu trúc màn chat) ========== -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_header"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/cyan_glow"
                android:contentDescription="Quay lại" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="//dr.bug's chat room"
                android:textColor="@color/cyan_glow"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Pills row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/btnSessions"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chat_pill"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Các session của bạn"
                android:textColor="@color/cyan_text"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chat_pill"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:hint="Tìm kiếm"
                android:textColor="@color/cyan_text"
                android:textColorHint="@color/cyan_text"
                android:textSize="13sp"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSearch" />

            <ImageView
                android:id="@+id/btnAddSession"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chat_add"
                android:padding="9dp"
                android:src="@drawable/ic_add"
                app:tint="@color/cyan_glow"
                android:contentDescription="Session mới" />
        </LinearLayout>
    </LinearLayout>

    <!-- "Quay trở lại session hiện tại..." -->
    <TextView
        android:id="@+id/tvBackToCurrent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:text="Quay trở lại session hiện tại..."
        android:textColor="@color/cyan_text"
        android:textSize="13sp"
        android:textStyle="italic"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Vùng danh sách session (nền tối để pill trắng nổi bật) -->
    <FrameLayout
        android:id="@+id/listContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#0A0E12"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvBackToCurrent"
        app:layout_constraintBottom_toTopOf="@id/ivMascot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSessions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />

        <!-- Empty state: chưa có session nào (chỉ hiện khi list rỗng) -->
        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Chưa có session nào.\nBắt đầu trò chuyện để tạo session đầu tiên."
            android:textColor="@color/text_hint"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Mascot Dr.Bug ở dưới -->
    <ImageView
        android:id="@+id/ivMascot"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="48dp"
        android:src="@drawable/ic_mascot"
        android:contentDescription="Dr.Bug"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
