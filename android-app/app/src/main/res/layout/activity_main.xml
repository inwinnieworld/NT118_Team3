<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_student_homescreen">

    <LinearLayout
        android:id="@+id/layoutTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_top_menu_glass"
        android:paddingStart="24dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="55dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvEmotionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emotion Debugging"
            android:textColor="#85E9FF"
            android:textSize="36sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutTopMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:layout_marginEnd="3dp"

        app:layout_constraintTop_toBottomOf="@id/layoutTitle"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivUserInfo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_userinfo"
            android:clickable="true"
            android:focusable="true" />
        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_notification"
            android:clickable="true"
            android:focusable="true" />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_setting" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivMascot"
        android:layout_width="200dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_mascot"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.74"
        app:layout_constraintHorizontal_bias="0.58" />

    <LinearLayout
        android:id="@+id/cardWelcome"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_welcome_bubble"
        android:padding="16dp"
        android:layout_marginBottom="-30dp"
        app:layout_constraintBottom_toTopOf="@id/ivMascot"

        android:layout_marginEnd="140dp"
        app:layout_constraintEnd_toEndOf="@id/ivMascot">

        <TextView
            android:id="@+id/tvWelcomeMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/dockBackground"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_glass_card"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpIcons"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
