<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_trace_group_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvErrorCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="bug_report"
            android:textColor="#203040"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:gravity="end"
            android:text="BUILD FAILED"
            android:textColor="#11A0C4"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/edtSearchQuestion"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_trace_search"
        android:hint="Tìm kiếm câu hỏi..."
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#203040"
        android:textColorHint="#9AA6B2" />

    <LinearLayout
        android:id="@+id/layoutQuestionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

</LinearLayout>