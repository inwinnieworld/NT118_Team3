<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Back"
        android:padding="12dp"
        android:tint="#FFFFFF"
        android:background="?attr/selectableItemBackgroundBorderless" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="80dp"
        android:text="Git Graph"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <!-- Git Graph View (Scrollable) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="80dp"
        android:fillViewport="true">

        <com.example.emotiondebugging.ui.gitgraph.GitGraphView
            android:id="@+id/gitGraphView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent" />

    </ScrollView>

    <!-- Zoom Controls (Right side) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_zoom_controls"
        android:padding="8dp">

        <!-- Zoom In -->
        <ImageView
            android:id="@+id/btnZoomIn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="Zoom In"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#06B6D4" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginVertical="4dp"
            android:background="#374151" />

        <!-- Zoom Out -->
        <ImageView
            android:id="@+id/btnZoomOut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_delete"
            android:contentDescription="Zoom Out"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#06B6D4" />

    </LinearLayout>

    <!-- Daily Merge FAB (Bottom Left) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDailyMerge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_menu_save"
        android:contentDescription="Daily Merge"
        app:backgroundTint="#06B6D4"
        app:tint="#FFFFFF"
        android:visibility="gone" />

    <!-- Daily Merge Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="90dp"
        android:text="Daily Merge"
        android:textColor="#06B6D4"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:background="@drawable/bg_label"
        android:padding="8dp" />

</FrameLayout>
