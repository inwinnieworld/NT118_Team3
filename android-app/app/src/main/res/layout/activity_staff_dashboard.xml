<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_student_homescreen">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_staff_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#12000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="145dp"
        android:background="@drawable/bg_manage_quest_topbar"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="26dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-light"
            android:text="Emotion Debugging"
            android:textColor="#7CE8FF"
            android:textSize="30sp" />

        <LinearLayout
            android:id="@+id/iconBar"
            android:layout_width="250dp"
            android:layout_height="54dp"
            android:layout_gravity="end"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_staff_icon_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="34dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/ivMessage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="34dp"
                android:src="@android:drawable/ic_dialog_email"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/ivSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/ivLogout"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="34dp"
                android:src="@drawable/ic_logout"
                android:tint="@android:color/white"
                android:contentDescription="Log out"
                android:tooltipText="Log out"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivCenterCore"
        android:layout_width="700dp"
        android:layout_height="900dp"
        android:adjustViewBounds="true"
        android:contentDescription="core"
        android:scaleType="fitCenter"
        android:src="@drawable/img_staff_core"
        android:translationY="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.507"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <LinearLayout
        android:id="@+id/taskPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_staff_task_panel"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="CHỌN CÔNG VIỆC MUỐN LÀM"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnManageQuest"
            android:layout_width="155dp"
            android:layout_height="46dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_staff_home_button"
            android:gravity="center"
            android:text="Quản lý Quest"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnQuestBuilder"
            android:layout_width="155dp"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_staff_home_button"
            android:gravity="center"
            android:text="Quest Builder"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnQuestReport"
            android:layout_width="155dp"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_staff_home_button"
            android:gravity="center"
            android:text="Báo cáo quest"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/viewMascotGlow"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginTop="-42dp"
        android:layout_marginEnd="-4dp"
        android:alpha="0.95"
        android:background="@drawable/bg_staff_mascot_glow"
        app:layout_constraintBottom_toTopOf="@id/tvStaffStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/taskPanel" />

    <ImageView
        android:id="@+id/ivMascot"
        android:layout_width="181dp"
        android:layout_height="158dp"
        android:layout_marginTop="-52dp"
        android:layout_marginEnd="2dp"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:contentDescription="mascot"
        android:scaleType="fitCenter"
        android:src="@drawable/img_staff_mascot"
        app:layout_constraintBottom_toTopOf="@id/tvStaffStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/taskPanel"
        app:layout_constraintVertical_bias="0.485" />

    <TextView
        android:id="@+id/tvStaffStatus"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="42dp"
        android:layout_marginEnd="42dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_staff_status"
        android:gravity="center"
        android:text="Staff [Người dùng] đang đăng nhập"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
