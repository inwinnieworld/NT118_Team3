<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_student_homescreen">

    <LinearLayout
        android:id="@+id/layoutTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_menu_glass"
        android:paddingStart="24dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emotion Debugging"
            android:textColor="#85E9FF"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutTopMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTitle"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_userinfo" />
        <ImageView
            android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_notification" />
        <ImageView
            android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_setting" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardStaffMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_admin_menu_card"
        android:padding="24dp"
        android:layout_marginHorizontal="32dp"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTopMenu"
        app:layout_constraintBottom_toTopOf="@id/layoutStaffStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHỌN CÔNG VIỆC MUỐN LÀM"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnManageQuest"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_admin_button"
            android:text="Quản lý Quest" android:textAllCaps="false"
            android:textColor="#000000" android:textStyle="bold"
            android:layout_marginBottom="12dp" android:elevation="4dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReportQuest"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_admin_button"
            android:text="Báo cáo quest" android:textAllCaps="false"
            android:textColor="#000000" android:textStyle="bold"
            android:layout_marginBottom="12dp" android:elevation="4dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnManageTraceError"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_admin_button"
            android:text="Quản lý bộ câu hỏi Trace Error" android:textAllCaps="false"
            android:textColor="#000000" android:textStyle="bold"
            android:elevation="4dp"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivStaffMascot"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_mascot"
        android:elevation="12dp"
        android:layout_marginEnd="-20dp"
        android:layout_marginBottom="-30dp"
        app:layout_constraintEnd_toEndOf="@id/cardStaffMenu"
        app:layout_constraintBottom_toBottomOf="@id/cardStaffMenu" />

    <LinearLayout
        android:id="@+id/layoutStaffStatus"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_admin_status"
        android:gravity="center"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvStaffStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Background -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_staff_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Overlay tối nhẹ -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#12000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="145dp"
        android:background="@drawable/bg_manage_quest_topbar"
        android:orientation="vertical"
        android:paddingTop="26dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Emotion Debugging"
            android:textColor="#7CE8FF"
            android:textSize="30sp"
            android:fontFamily="sans-serif-light" />

        <LinearLayout
            android:id="@+id/iconBar"
            android:layout_width="250dp"
            android:layout_height="54dp"
            android:layout_gravity="end"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_staff_icon_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="34dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/ivMessage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="34dp"
                android:src="@android:drawable/ic_dialog_email"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/ivSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Máy / khung tròn trung tâm: TO HƠN -->

    <!-- Panel công việc -->

    <ImageView
        android:id="@+id/ivCenterCore"
        android:layout_width="700dp"
        android:layout_height="900dp"
        android:adjustViewBounds="true"
        android:contentDescription="core"
        android:scaleType="fitCenter"
        android:src="@drawable/img_staff_core"
        android:translationY="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.507"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <LinearLayout
        android:id="@+id/taskPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_staff_task_panel"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="CHỌN CÔNG VIỆC MUỐN LÀM"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnManageQuest"
            android:layout_width="155dp"
            android:layout_height="46dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_staff_home_button"
            android:gravity="center"
            android:text="Quản lý Quest"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnQuestReport"
            android:layout_width="155dp"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_staff_home_button"
            android:gravity="center"
            android:text="Báo cáo quest"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTraceQuestion"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_staff_home_button"
            android:gravity="center"
            android:text="Quản lý bộ câu hỏi Trace Error"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Glow mờ sau mascot -->
    <View
        android:id="@+id/viewMascotGlow"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginTop="-42dp"
        android:layout_marginEnd="-4dp"
        android:alpha="0.95"
        android:background="@drawable/bg_staff_mascot_glow"
        app:layout_constraintTop_toBottomOf="@id/taskPanel"
        app:layout_constraintBottom_toTopOf="@id/tvStaffStatus"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mascot -->

    <!-- Status -->
    <ImageView
        android:id="@+id/ivMascot"
        android:layout_width="181dp"
        android:layout_height="158dp"
        android:layout_marginTop="-52dp"
        android:layout_marginEnd="2dp"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:contentDescription="mascot"
        android:scaleType="fitCenter"
        android:src="@drawable/img_staff_mascot"
        app:layout_constraintBottom_toTopOf="@id/tvStaffStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/taskPanel"
        app:layout_constraintVertical_bias="0.485" />

    <TextView
        android:id="@+id/tvStaffStatus"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="42dp"
        android:layout_marginEnd="42dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_staff_status"
        android:gravity="center"
        android:text="Staff [Người dùng] đang đăng nhập"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>