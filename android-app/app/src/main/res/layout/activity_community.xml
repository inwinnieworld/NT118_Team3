<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_community_screen">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="16dp">

        <!-- Title row -->
        <LinearLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back"
                android:tint="@color/white" />

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="DEBUGGING COMMUNITY"
                android:textColor="#12B2C1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <ImageView
                android:id="@+id/iv_header_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:padding="0dp" />

        </LinearLayout>

        <!-- Search + filter row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_community"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    android:tint="#AAFFFFFF"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="Tìm kiếm bài viết..."
                    android:textColorHint="#AAFFFFFF"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:inputType="text"
                    android:singleLine="true" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp">

                <ImageButton
                    android:id="@+id/btn_notifications"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_search_community"
                    android:src="@drawable/ic_heart"
                    android:tint="@color/white"
                    android:padding="8dp"
                    android:contentDescription="Thông báo" />

                <TextView
                    android:id="@+id/tv_notif_badge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btn_filter"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_search_community"
                android:src="@drawable/ic_more"
                android:tint="@color/white"
                android:padding="8dp"
                android:contentDescription="Filter" />
        </LinearLayout>
    </LinearLayout>

    <!-- Content area: RecyclerView + FAB stacked via FrameLayout -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_posts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:paddingBottom="64dp"
            android:clipToPadding="false" />

        <!-- Filter dropdown -->
        <LinearLayout
            android:id="@+id/layout_filter_menu"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_filter_menu"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            android:visibility="gone"
            android:elevation="8dp">

            <TextView android:id="@+id/filter_new" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="NEW" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" android:background="?attr/selectableItemBackground" />
            <TextView android:id="@+id/filter_trending" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="TRENDING" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" android:background="?attr/selectableItemBackground" />
            <TextView android:id="@+id/filter_best" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="BEST" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" android:background="?attr/selectableItemBackground" />
            <TextView android:id="@+id/filter_topic" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="TOPIC" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- FAB -->
        <LinearLayout
            android:id="@+id/btn_create_post"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_fab_post"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
