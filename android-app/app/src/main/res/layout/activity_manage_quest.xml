<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_manage_quest_screen"
    tools:context=".ui.staff.ManageQuestActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_manage_quest_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#8EF0FF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="QUẢN LÝ QUEST"
            android:textColor="#7BE8FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp" />
    </LinearLayout>

    <View
        android:id="@+id/headerGlow"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_manage_header_glow"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="DANH SÁCH CÁC QUEST"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/viewHeaderRedAccent"
        android:layout_width="220dp"
        android:layout_height="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_header_red_accent"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintStart_toStartOf="@id/tvHeader"
        app:layout_constraintEnd_toEndOf="@id/tvHeader" />

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_manage_quest_card"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toBottomOf="@id/viewHeaderRedAccent"
        app:layout_constraintBottom_toTopOf="@id/btnAddQuest"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@drawable/bg_search_outer"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/etSearchQuest"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_search_inner"
                android:gravity="center"
                android:hint="Tìm kiếm quest..."
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#50646F"
                android:textColorHint="#8EA2AE"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#22000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuest"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fadeScrollbars="false"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:scrollbarThumbVertical="@drawable/bg_scroll_thumb"
            android:scrollbarTrackVertical="@drawable/bg_scroll_track"
            android:scrollbars="vertical"
            tools:itemCount="6"
            tools:listitem="@layout/item_quest" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAddQuest"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_add_quest_button"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="[ + THÊM_QUEST ]"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:shadowColor="#33000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>