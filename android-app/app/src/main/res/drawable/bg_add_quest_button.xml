<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow -->
    <item android:top="3dp">
        <shape>
            <solid android:color="#22000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Main button -->
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#4C526C9F"
                android:centerColor="#4456759F"
                android:endColor="#2B3B5E8A" />
            <stroke
                android:width="1.2dp"
                android:color="#EAFBFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- đường sáng bên trái kiểu UI tech -->
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="54dp"
        android:bottom="10dp">
        <shape>
            <solid android:color="#66FFFFFF" />
            <size android:width="1dp" />
        </shape>
    </item>

</layer-list>