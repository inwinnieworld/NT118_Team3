# .gitignore cho Android Project
# ============================================

# ===== Gradle Build Files =====
.gradle/
build/
*/build/
app/build/
local.properties

# ===== Android Studio / IntelliJ IDEA =====
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries/
.idea/caches/
.idea/modules.xml
.idea/.name
.idea/compiler.xml
.idea/jarRepositories.xml
.idea/navEditor.xml
.idea/deploymentTargetDropDown.xml
.idea/render.experimental.xml

# Giữ lại một số file .idea/ để team có cùng config
# !.idea/codeStyles/
# !.idea/inspectionProfiles/
# !.idea/vcs.xml

# ===== VS Code =====
.vscode/

# ===== Android Generated Files =====
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
output-metadata.json
output.json

# ===== Keystore Files (QUAN TRỌNG - Không push lên GitHub) =====
*.jks
*.keystore
key.properties

# ===== Google Services =====
google-services.json
# Nếu cần share config Firebase, comment dòng trên

# ===== Log Files =====
*.log

# ===== Android Profiling =====
*.hprof

# ===== OS Files =====
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Linux
*~
.directory

# ===== Java/Kotlin Compiled Files =====
*.class
bin/
gen/
out/
release/

# ===== Backup Files =====
*.bak
*.swp
*.swo
*~

# ===== Misc =====
.navigation/
*.ipr
*.iws
.mtj.tmp/
hs_err_pid*
replay_pid*
